# ── MongoDB ────────────────────────────────────────────────────────────────
# Connection string used by lib/db.ts (Mongoose).
# Copy this file to .env.local and set your real connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/etfc

# ── App ────────────────────────────────────────────────────────────────────
# Public URL of the app — used to build webhook callbacks & redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Chapa (domestic ETB — Telebirr, CBE Birr, cards) ──────────────────────
# API key from https://dashboard.chapa.co (used as Bearer token AND to sign
# webhook payloads unless CHAPA_WEBHOOK_SECRET is set separately).
CHAPA_SECRET_KEY=
# Optional: set if your Chapa webhook secret hash differs from the API key.
CHAPA_WEBHOOK_SECRET=
# Webhook URL to configure in the Chapa dashboard:
#   <NEXT_PUBLIC_APP_URL>/api/webhooks/chapa

# ── Stripe (international USD for the diaspora) ───────────────────────────
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks
# Endpoint to configure: <NEXT_PUBLIC_APP_URL>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Digital ticket QR signing ─────────────────────────────────────────────
# Secret used to HMAC-sign every issued ticket QR payload.
# Generate one with: openssl rand -hex 32
TICKET_SIGNING_SECRET=
